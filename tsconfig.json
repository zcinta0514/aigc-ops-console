{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "resolveJsonModule": true, "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "isolatedModules": true,
    "noEmit": true, "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "scripts/**/*.ts", "tests/**/*.ts", "*.ts", "env.d.ts"]
}
